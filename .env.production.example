# انسخ هذا الملف على الخادم باسم .env.production واملأ كل القيم بين الأقواس.
# لا ترفع .env.production إلى Git ولا تشارك محتواه في المحادثات.

# النطاق والشهادة
PUBLIC_DOMAIN=erp.example.sa
TLS_EMAIL=operations@example.sa

# PostgreSQL: استخدم كلمة مرور عشوائية قوية (32 حرفًا أو أكثر)
POSTGRES_USER=masar_app
POSTGRES_PASSWORD=<generate-a-strong-postgres-password>
POSTGRES_DB=masar_erp

# Redis: كلمة مرور عشوائية قوية (32 حرفًا أو أكثر)
REDIS_PASSWORD=<generate-a-strong-redis-password>

# Backend runtime
APP_ENV=production
SECRET_KEY=<generate-at-least-32-random-characters>
SUPER_ADMIN_SECRET=<generate-at-least-24-random-characters>
ENABLE_SUPER_ADMIN_BOOTSTRAP=false
CORS_ORIGINS=https://erp.example.sa
SMACC_AI_PREVIEW_AUTOCONFIG=0

# اختياري: لا تضف مفتاحًا إن لم تكن الخرائط تستخدم Mapbox.
NEXT_PUBLIC_MAPBOX_TOKEN=
