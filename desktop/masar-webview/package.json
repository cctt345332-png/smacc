{
  "name": "masar-webview",
  "version": "1.0.0",
  "description": "تطبيق سطح مكتب خفيف لواجهة مسار ERP",
  "main": "main.js",
  "author": "Masar ERP",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win:setup": "electron-builder --win nsis --publish never --config.artifactName='Masar-ERP-Setup-${version}-${arch}.${ext}'",
    "dist:win:portable": "electron-builder --win portable --publish never --config.artifactName='Masar-ERP-Portable-${version}-${arch}.${ext}'",
    "dist:win": "npm run dist:win:setup && npm run dist:win:portable",
    "dist:all": "electron-builder --linux AppImage --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.masar.erp",
    "productName": "Masar ERP",
    "artifactName": "Masar-ERP-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "compression": "maximum",
    "publish": [],
    "files": [
      "main.js",
      "assets/**/*",
      "package.json"
    ],
    "icon": "assets/masar-icon.png",
    "linux": {
      "target": ["AppImage"],
      "category": "Office",
      "executableName": "masar-erp"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Masar ERP"
    }
  }
}
